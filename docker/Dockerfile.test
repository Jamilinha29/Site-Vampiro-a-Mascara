FROM node:22-alpine
WORKDIR /app
COPY package.json package-lock.json ./
COPY backend/package.json backend/
COPY frontend/package.json frontend/
RUN npm ci
COPY backend backend
COPY frontend frontend
COPY test test
COPY docker/nginx.conf docker/nginx.conf
COPY vercel.json ./
CMD ["npm", "run", "test:ci"]
