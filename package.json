{
  "name": "rpg-beladona",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "npm run dev -w frontend",
    "dev:api": "npm run dev -w backend",
    "dev:all": "npx concurrently -n api,web -c blue,green \"npm run dev:api\" \"npm run dev\"",
    "build": "npm run build -w frontend",
    "build:vercel": "npm run build -w backend && npm run build -w frontend",
    "test:ci": "vitest run --config test/vitest.config.ts",
    "lint": "tsc -p backend/tsconfig.json --noEmit && npm run lint -w frontend",
    "verify:git": "node scripts/verify-git-clean.js",
    "verify:bundle": "node scripts/verify-git-clean.js --check-dist",
    "backup:export": "node scripts/backup-disaster.mjs export",
    "backup:decrypt": "node scripts/backup-disaster.mjs decrypt",
    "backup:check": "node scripts/backup-disaster.mjs check",
    "docker:dev": "docker compose up --build",
    "docker:prod": "docker compose -f compose.prod.yaml up --build",
    "docker:test": "docker compose -f compose.test.yaml up --build --abort-on-container-exit --exit-code-from tests"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ]
}
