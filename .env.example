VITE_API_URL=http://localhost:4000
# API do browser: vazio = mesmo host (Vercel) ou proxy Vite (:5173 → :4000)
VITE_API_URL=http://localhost:4000
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Só chave PÚBLICA (anon / publishable). Nunca sb_secret_ nem service role no Vite.
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key

PORT=4000
CORS_ORIGIN=http://localhost:5173
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Mesma chave pública que no Vite (login/cadastro na API). Não use service role aqui.
SUPABASE_ANON_KEY=your-publishable-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-never-in-frontend
# Local sem login do Supabase: true. Em produção o servidor ignora este valor e exige Supabase.
ALLOW_DEV_AUTH=true
# Correios do mestre, separados por vírgula. Só o servidor lê isto. Não use o prefixo do e-mail como senha de mestre.
NARRATOR_EMAILS=
RUN_STANDALONE=true
RESEND_API_KEY=
RESEND_FROM=Beladona <onboarding@resend.dev>
# Site usado no link do corvo. Vazio = o primeiro CORS_ORIGIN. Sem RESEND_API_KEY o pedido responde igual, mas o e-mail não sai.
PUBLIC_APP_URL=
