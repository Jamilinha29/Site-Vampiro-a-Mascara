# Frontend (Vite) — vazio em produção na Vercel (= mesmo host /api/...). Em Docker dev local: http://localhost:4000
VITE_API_URL=http://localhost:4000
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Só chave PÚBLICA (anon / publishable). Nunca coloque sb_secret_ nem service_role no Vite.
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key

# Backend API
PORT=4000
CORS_ORIGIN=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Chave pública/anon para login/cadastro/refresh na API (não use service_role aqui).
SUPABASE_ANON_KEY=your-publishable-anon-key
# Chave privilegiada do servidor (somente backend/CI/Vercel env — nunca expor no frontend).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-never-in-frontend

# Dev local sem Supabase Auth (em produção/Vercel o servidor ignora e bloqueia tokens dev)
ALLOW_DEV_AUTH=true
RUN_STANDALONE=true

# Controle explícito de papéis no servidor (e-mails separados por vírgula)
ADMIN_EMAILS=
NARRATOR_EMAILS=

# E-mail (opcional — Supabase Auth já envia confirmação/recuperação; marque true após configurar SMTP próprio no Supabase)
RESEND_API_KEY=
RESEND_FROM=Beladona <onboarding@resend.dev>
SUPABASE_SMTP_VERIFIED=false
